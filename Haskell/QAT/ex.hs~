-- random functions
interleaving :: [String] -> [String] -> [[String]]
interleaving [] l2 = [l2]
interleaving l1 [] = [l1]
interleaving l1@(e1:t1) l2@(e2:t2) = let int1 = interleaving t1 l2
                                         int2 = interleaving l1 t2
                                     in (map (\x -> e1 : x) int1) ++ (map (\x -> e2 : x) int2)

-- balanced parentheses () or brackets [] or curly brackets {}
balancedPar :: String -> Bool
balancedPar [] = True
balancedPar s = balancedParAux s []

balancedParAux :: String -> [Char] -> Bool
balancedParAux [] [] = True
balancedParAux [] stack = False
balancedParAux (h:t) stack = if h == '(' || h == '{' || h == '['
                             then balancedParAux t (h:stack)
                             else case null stack of
                                    True -> False
                                    False -> case h of
                                      ')' -> if head stack == '('
                                             then balancedParAux t (tail stack)
                                             else False
                                      '}' -> if head stack == '{'
                                             then balancedParAux t (tail stack)
                                             else False
                                      ']' -> if head stack == '['
                                             then balancedParAux t (tail stack)
                                             else False

