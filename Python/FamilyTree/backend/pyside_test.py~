import sys
import random
from PySide6 import QtCore, QtWidgets, QtGui


from PySide6.QtWidgets import (
    QApplication, QMainWindow, QGraphicsView, QGraphicsScene,
    QGraphicsRectItem, QGraphicsEllipseItem, QPushButton, QWidget,
    QVBoxLayout
)
from PySide6.QtGui import QPen, QBrush
from PySide6.QtCore import Qt, QRectF, Slot
import sys

class PersonItem(QGraphicsRectItem):
    def __init__(self, person_id, name, x, y):
        super().__init__(QRectF(0, 0, 120, 50))
        self.person_id = person_id
        self.name = name
        self.setPos(x, y)
        self.setBrush(QBrush(Qt.white))
        self.setPen(QPen(Qt.black, 2))
        self.setFlag(QGraphicsRectItem.ItemIsMovable)
        self.setFlag(QGraphicsRectItem.ItemIsSelectable)


class UnionItem(QGraphicsEllipseItem):
    def __init__(self, union_id, x, y):
        super().__init__(QRectF(0, 0, 16, 16))
        self.union_id = union_id
        self.setPos(x, y)
        self.setBrush(QBrush(Qt.black))
        self.setFlag(QGraphicsEllipseItem.ItemIsMovable)
        self.setFlag(QGraphicsEllipseItem.ItemIsSelectable)


class FamilyTreeScene(QGraphicsScene):
    def __init__(self):
        super().__init__()

    def add_person_item(self, person_id, name, x, y):
        item = PersonItem(person_id, name, x, y)
        self.addItem(item)
        return item

    def add_union_item(self, union_id, x, y):
        item = UnionItem(union_id, x, y)
        self.addItem(item)
        return item


class FamilyTreeView(QGraphicsView):
    def __init__(self, scene):
        super().__init__(scene)
        self.setDragMode(QGraphicsView.RubberBandDrag)
        self.setRenderHints(self.renderHints())

    def wheelEvent(self, event):
        factor = 1.15 if event.angleDelta().y() > 0 else 1 / 1.15
        self.scale(factor, factor)


@Slot()
def add_family():
    print("You pressed a button, congrats")

        
class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("FamilyTree")

        self.scene = FamilyTreeScene()
        self.view = FamilyTreeView(self.scene)
        #self.setCentralWidget(self.view)

        button = QPushButton("Add family")
        button.clicked.connect(add_family)
        #button.show()

        central = QWidget()
        layout = QVBoxLayout(central)
        layout.addWidget(button)
        layout.addWidget(self.view)

        self.setCentralWidget(central)
        
        self.scene.add_person_item("p1", "Alice", 100, 100)
        self.scene.add_person_item("p2", "Bob", 300, 100)
        self.scene.add_union_item("u1", 220, 180)




if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MainWindow()
    window.resize(1000, 700)
    window.show()
    sys.exit(app.exec())
