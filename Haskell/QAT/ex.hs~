import Data.Maybe
import Data.List
import Data.Either

type CVar = String
type S = [(CVar, Int)]
type QVar = String

data AExp = Num Int
           | Var String
           | Add AExp AExp
           | Sub AExp AExp
           | Mul AExp AExp
           | Div AExp AExp
           | Neg AExp
           deriving (Show, Eq)

data BExp = TT
          | FF
          | And BExp BExp
          | Or BExp BExp
          | Eq AExp AExp
          | Leq AExp AExp
          | Not BExp
          deriving (Show, Eq)

data C = Skip
       | Asg CVar AExp
       | Seq C C
       | If BExp C C
       | Whi BExp C
       deriving (Show, Eq)

data QCirc = U G [QVar]
           | SeqQ QCirc QCirc
           | Meas QVar QCirc QCirc
           deriving (Show, Eq)

data G = Id
       | X
       | Y
       | Z
       | H
       | S
       | T
       | CX
       | CZ
       | TOF
       | P0 -- special gate to denote a projection to |0>
       | P1 -- special gate to denote a projection to |1>
       deriving (Show, Eq)

evalAExp :: AExp -> S -> Maybe Int
evalAExp (Num n) _ = Just n
evalAExp (Var v) s = lookUp v s
evalAExp (Add ae1 ae2) s = let n1 = evalAExp ae1 s
                               n2 = evalAExp ae2 s
                            in if isJust n1 == True && isJust n2 == True
                               then Just (fromJust n1 + fromJust n2)
                               else Nothing
evalAExp (Sub ae1 ae2) s = let n1 = evalAExp ae1 s
                               n2 = evalAExp ae2 s
                            in if isJust n1 == True && isJust n2 == True
                               then Just (fromJust n1 - fromJust n2)
                               else Nothing
evalAExp (Mul ae1 ae2) s = let n1 = evalAExp ae1 s
                               n2 = evalAExp ae2 s
                            in if isJust n1 == True && isJust n2 == True
                               then Just (fromJust n1 * fromJust n2)
                               else Nothing
evalAExp (Div ae1 ae2) s = let n1 = evalAExp ae1 s
                               n2 = evalAExp ae2 s
                            in if isJust n1 == True && isJust n2 == True
                               then if fromJust n2/=0
                                    then Just (fromJust n1 `div` fromJust n2)
                                    else Nothing
                               else Nothing
evalAExp (Neg ae) s = let n = evalAExp ae s
                       in if isJust n==True
                          then Just (- fromJust n)
                          else Nothing

evalBExp :: BExp -> S -> Maybe Bool
evalBExp TT _ = Just True
evalBExp FF _ = Just False
evalBExp (And bexp1 bexp2) s = let b1 = evalBExp bexp1 s
                                   b2 = evalBExp bexp2 s
                               in if (isJust b1 == True) && (isJust b2 == True)
                                  then Just $ (fromJust b1) && (fromJust b2)
                                  else Nothing
evalBExp (Or bexp1 bexp2) s = let b1 = evalBExp bexp1 s
                                  b2 = evalBExp bexp2 s
                               in if (isJust b1 == True) && (isJust b2 == True)
                                  then Just $ (fromJust b1) || (fromJust b2)
                                  else Nothing
evalBExp (Eq aexp1 aexp2) s = let n1 = evalAExp aexp1 s
                                  n2 = evalAExp aexp2 s
                              in if (isJust n1 == True) && (isJust n2 == True)
                                 then Just $ n1==n2
                                 else Nothing
evalBExp (Leq aexp1 aexp2) s = let n1 = evalAExp aexp1 s
                                   n2 = evalAExp aexp2 s
                               in if (isJust n1 == True) && (isJust n2 == True)
                                  then Just $ n1<=n2
                                  else Nothing
  
simplifyAExp :: AExp -> AExp
simplifyAExp (Num n) = (Num n)
simplifyAExp (Var v) = Var v
simplifyAExp (Add ae1 (Num 0)) = simplifyAExp ae1
simplifyAExp (Add (Num 0) ae2) = simplifyAExp ae2
simplifyAExp (Add ae1 ae2) = let ae1' = simplifyAExp ae1
                                 ae2' = simplifyAExp ae2
                              in (Add ae1' ae2')
simplifyAExp (Sub ae1 (Num 0)) = simplifyAExp ae1
simplifyAExp (Sub (Num 0) ae2) = simplifyAExp ae2
simplifyAExp (Sub ae1 ae2) = let ae1' = simplifyAExp ae1
                                 ae2' = Neg (simplifyAExp ae2)
                              in (Sub ae1' ae2')
simplifyAExp (Mul ae1 (Num 1)) = simplifyAExp ae1                                 
simplifyAExp (Mul (Num 1) ae2) = simplifyAExp ae2
simplifyAExp (Mul ae1 (Num 0)) = Num 0
simplifyAExp (Mul (Num 0) ae2) = Num 0
simplifyAExp (Mul ae1 ae2) = let ae1' = simplifyAExp ae1
                                 ae2' = simplifyAExp ae2
                              in (Mul ae1' ae2')
simplifyAExp (Div ae1 (Num 1)) = simplifyAExp ae1
simplifyAExp (Div ae1 (Num 0)) = error "simplifyAExp: The denominator cannot be zero!"
simplifyAExp (Div (Num 0) ae2) = Num 0
simplifyAExp (Div ae1 ae2) = let ae1' = simplifyAExp ae1
                                 ae2' = simplifyAExp ae2
                              in (Div ae1' ae2')


vars :: AExp -> [String]
vars (Num n) = []
vars (Var v) = [v]
vars (Add ae1 ae2) = nub $ (vars ae1 ++ vars ae2)
vars (Sub ae1 ae2) = nub $ (vars ae1 ++ vars ae2)
vars (Mul ae1 ae2) = nub $ (vars ae1 ++ vars ae2)
vars (Div ae1 ae2) = nub $ (vars ae1 ++ vars ae2)
vars (Neg ae) = nub $ vars ae


depth :: AExp -> Int
depth (Num n) = 0
depth (Var v) = 0
depth (Add ae1 ae2) = 1 + depth ae1 + depth ae2
depth (Sub ae1 ae2) = 1 + depth ae1 + depth ae2
depth (Mul ae1 ae2) = 1 + depth ae1 + depth ae2
depth (Div ae1 ae2) = 1 + depth ae1 + depth ae2
depth (Neg ae) = depth ae


step :: C -> S -> Either S (C,S)
step Skip s = Left s
step (Asg var aexp) s = let n = evalAExp aexp s
                        in if isJust n == True
                           then Left $ updS s var (fromJust n)
                           else error "step: The arithmetic expression evaluated to Nothing" 
step (Seq c1 c2) s = case step c1 s of
                       Left s' -> Right (c2, s')
                       Right (c1', s') -> Right (Seq c1' c2, s')
step (If bexp c1 c2) s = let b = evalBExp bexp s
                         in if isJust b == True
                            then if fromJust b == True
                                 then Right (c1, s)
                                 else Right (c2, s)
                            else error "step: The Boolean expression evaluated to Nothing"
step (Whi bexp c) s = let b = evalBExp bexp s
                      in if isJust b == True
                         then if fromJust b == True
                              then Right (Seq c (Whi bexp c), s)
                              else Left s
                         else error "step: The Boolean expression evaluated to Nothing"


run :: C -> S -> S
run Skip s = s
run (Asg var aexp) s = let n = evalAExp aexp s
                       in if isJust n == True
                          then updS s var (fromJust n)
                          else error "step: The arithmetic expression evaluated to Nothing" 
run (Seq c1 c2) s = let s' = run c1 s
                    in run c2 s'
run (If bexp c1 c2) s = let b = evalBExp bexp s
                        in if isJust b == True
                           then if fromJust b == True
                                then run c1 s
                                else run c2 s
                           else error "step: The Boolean expression evaluated to Nothing"
run (Whi bexp c) s = let b = evalBExp bexp s
                      in if isJust b == True
                         then if fromJust b == True
                              then run (Seq c (Whi bexp c)) s
                              else s
                         else error "step: The Boolean expression evaluated to Nothing"                       
                           
updS :: S -> CVar -> Int -> S
updS [] v _ = error ("updS: The variable" ++ v ++ "does not exist")
updS ((var, val):t) v n = if var==v
                          then (var, n) : t
                          else (var, val) : updS t v n

lookUp :: CVar -> S -> Maybe Int
lookUp v [] = Nothing
lookUp v ((var,s):t) = if v==var
                       then Just s
                       else lookUp v t 



-- Transition systems
-- reach: Starting Point -> Transitions -> Bool
reachable :: Int -> [(Int, Int)] -> [Int]
reachable n [] = [n]
reachable n l = reachableAux [n] l []

reachableAux :: [Int] -> [(Int, Int)] -> [Int] -> [Int]
reachableAux [] _ reached = reached
reachableAux (n:todo) l reached = if elem n reached
                                  then reachableAux todo l reached
                                  else let successors = [e2 | (e1,e2) <- l, e1==n]
                                       in reachableAux (successors++todo) l (n:reached)

hasCycle :: [(Int, Int)] -> Bool
hasCycle [] = False
hasCycle l = let l_tc = transitiveClosure l
             in not $ null [True | (e1,e2)<-l_tc, e1==e2]
                                              
transitiveClosure :: [(Int, Int)] -> [(Int, Int)]
transitiveClosure [] = []
transitiveClosure l = transClosAux l l []

transClosAux :: [(Int, Int)] -> [(Int, Int)] -> [(Int, Int)] -> [(Int, Int)]
transClosAux [] _ trans = trans
transClosAux ((e1,e2):todo) l trans = if elem (e1,e2) trans
                                      then transClosAux todo l trans
                                      else let next = [(e1, e4) | (e3, e4) <- l, e2==e3]
                                           in transClosAux (next++todo) l ((e1,e2):trans)

--allPaths :: start -> end -> Trans -> [Path]
allPaths :: Int -> Int -> [(Int, Int)] -> [[(Int, Int)]]
allPaths init end l = allPathsAux [(e1,e2) | (e1,e2)<-l, e1==init] end l []

allPathsAux :: [(Int,Int)] -> Int -> [(Int, Int)] -> [(Int, Int)] -> [[(Int, Int)]]
allPathsAux [] _ _ path = []
allPathsAux ((e1,e2):t) end l path = if e2==end
                                     then ((e1,e2):path) : allPathsAux t end l path
                                     else if elem (e1,e2) path
                                          then let next = [(e3,e4) | (e3,e4)<-l, e2==e3]
                                                   clean_next = filter (`notElem` path) next
                                               in allPathsAux clean_next end l path
                                          else (allPathsAux [(e3,e4) | (e3,e4)<-l, e2==e3] end l ((e1,e2):path)) ++
                                               (allPathsAux t end l (path))


shortestPath :: Int -> Int -> [(Int,Int)] -> [(Int,Int)]
shortestPath init end l = let paths = allPaths init end l
                          in pickMinimum paths

pickMinimum :: [[(Int,Int)]] -> [(Int, Int)]
pickMinimum [] = []
pickMinimum (h:[]) = h
pickMinimum (v1:v2:t) = if (length v1) < (length v2)
                        then pickMinimum (v1:t)
                        else pickMinimum (v2:t)


--Tiny Circuit representation
circuit_list :: QCirc -> [[(G, [QVar])]]
circuit_list (U g qvars) = [[(g, qvars)]]
circuit_list (SeqQ qc1 qc2) = let ll1 = circuit_list qc1
                                  ll2 = circuit_list qc2
                              in [l1++l2 | l1<-ll1, l2<-ll2]
circuit_list (Meas q qc1 qc2) = let ll1 = circuit_list qc1
                                    ll2 = circuit_list qc2
                                in [(P0, [q]) : l1 | l1 <- ll1] ++ [(P1, [q]) : l2 | l2 <- ll2]

countGates :: QCirc -> [([G], Int)]
countGates (U g _) = [([g], 1)]
countGates (SeqQ qc1 qc2) = let count1 = countGates qc1
                                count2 = countGates qc2
                            in [(g1++g2, i1+i2) | (g1,i1) <- count1, (g2,i2)<-count2]
countGates (Meas _ qc1 qc2) = let count1 = countGates qc1
                                  count2 = countGates qc2
                              in [(P0:g1, 1+i1) | (g1,i1) <- count1] ++ [(P1:g2, 1+i2) | (g2,i2) <- count2]

usedQubits :: QCirc -> [([G], [QVar])]
usedQubits (U g qvars) = [([g], qvars)]
usedQubits (SeqQ qc1 qc2) = let count1 = usedQubits qc1
                                count2 = usedQubits qc2
                            in [(g1++g2, nub $ (q1++q2)) | (g1,q1) <- count1, (g2,q2)<-count2]
usedQubits (Meas q qc1 qc2) = let count1 = usedQubits qc1
                                  count2 = usedQubits qc2
                              in [(P0:g1, nub $ (q:q1)) | (g1,q1) <- count1] ++ [(P1:g2, nub $ (q:q2)) | (g2,q2) <- count2]

depthEstimate :: QCirc -> Int
depthEstimate qcirc = maximum $ map snd (depthEstimateQVar qcirc)

-- gives the worst depth of the quantum circuit
depthEstimateQVar :: QCirc -> [(QVar, Int)]
depthEstimateQVar (U g qvars) = map (\q -> (q, 1)) qvars
depthEstimateQVar (SeqQ qc1 qc2) = let d1 = depthEstimateQVar qc1
                                       d2 = depthEstimateQVar qc2
                                       l12 = [(q1,i1+i2) | (q1,i1)<-d1, (q2,i2)<-d2, q1==q2]
                                       l1 = [(q1,i1) | (q1,i1)<-d1, (q,_)<-l12, q1/=q]
                                       l2 = [(q2,i2) | (q2,i2)<-d2, (q,_)<-l12, q2/=q]
                                   in  l12++l1++l2
depthEstimateQVar (Meas q qc1 qc2) = let d1 = depthEstimateQVar qc1
                                         d2 = depthEstimateQVar qc2
                                         res1 = f_aux (q,1) d1
                                         res2 = f_aux (q,1) d2
                                         n1 = maximum $ map snd res1
                                         n2 = maximum $ map snd res2
                                     in if n1>n2
                                        then res1
                                        else res2

f_aux :: (QVar, Int) -> [(QVar, Int)] -> [(QVar, Int)]
f_aux q [] = [q]
f_aux (q,i) ((q',i'):t) = if q==q'
                          then (q, i+i') : t
                          else (q', i') : f_aux (q,i) t


