--Matrix-vector multiplication
transposeVector :: [Double] -> [[Double]]
transposeVector v = [[e] | e <- v]

matVecVec :: [Double] -> [Double] -> Maybe Double
matVecVec [] [] = Just 0
matVecVec _ [] = Nothing
matVecVec [] _ = Nothing
matVecVec v1@(e1:t1) v2@(e2:t2) = if length v1 == length v2
                                  then add (Just (e1*e2)) (matVecVec t1 t2)
                                  else Nothing

add :: Maybe Double -> Maybe Double -> Maybe Double
add (Just e1) (Just e2) = Just (e1+e2)
add (Just e) Nothing = Just e
add Nothing (Just e) = Just e
add _ _ = Nothing


matVec :: [[Double]] -> [Double] -> Maybe [Double]
matVec [] _ = Just []
matVec m@(h:t) v = case length h == length v of
  False -> Nothing
  True -> case matVecVec h v of
    Nothing -> Nothing
    Just e -> case matVec t v of
      Nothing -> Nothing
      Just v' -> Just (e:v')


matMul :: [[Double]] -> [[Double]] -> Maybe [[Double]]
matMul [] [] = Just []
matMul _ [] = Nothing
matMul [] _ = Nothing
matMul m1@(v1:t1) m2@(v2:t2) = let (r1,c1) = matDim m1
                                   (r2,c2) = matDim m2
                               in if c1==r2
                                  then let m2t = my_transpose m2
                                       in matMulAux m1 m2t
                                  else Nothing

matMulAux :: [[Double]] -> [[Double]] -> Maybe [[Double]]
matMulAux [] [] = Just []
matMulAux [] m2t = Just m2t
matMulAux _ [] = Nothing
matMulAux (v1:[]) m2t = case matVec m2t v1 of
                          Just v -> Just [v]
                          _ -> Nothing
matMulAux (v1:t1) m2t = join_Just (matVec m2t v1) (matMulAux t1 m2t)
  where join_Just :: Maybe [Double] -> Maybe [[Double]] -> Maybe [[Double]]
        join_Just Nothing Nothing = Nothing
        join_Just _ Nothing = Nothing
        join_Just Nothing _ = Nothing
        join_Just (Just v) (Just m) = Just (v:m)

my_transpose :: [[Double]] -> [[Double]]
my_transpose [] = []
my_transpose m@(v:t) = my_transposeAux (transposeVector v) t

-- My_Transposed Vector -> Matrix -> My_Transposed Matrix
my_transposeAux :: [[Double]] -> [[Double]] -> [[Double]]
my_transposeAux vt [] = vt
my_transposeAux vt (v:t) =  let newvt = my_transposeAuxAux vt (transposeVector v)
                            in my_transposeAux newvt t

my_transposeAuxAux :: [[Double]] -> [[Double]] -> [[Double]]
my_transposeAuxAux [] [] = []
my_transposeAuxAux _ [] = []
my_transposeAuxAux [] _ = []
my_transposeAuxAux (e1:t1) (e2:t2) = (e1++e2) : my_transposeAuxAux t1 t2 


-- Matrix -> (rows, columns)
matDim :: [[Double]] -> (Int,Int)
matDim m@(h:t) = (length m, length h)


identity :: Int -> [[Double]]
identity 0 = []
identity n = identityAux n 1
  where identityAux :: Int -> Int -> [[Double]]
        identityAux 0 _ = []
        identityAux n m = let line = (replicate (m-1) 0.0) ++ ([1] ++ replicate (n-1) 0.0)
                          in line : identityAux (n-1) (m+1)


-- tensor product
tensor_vectors :: [Double] -> [Double] -> [Double]
tensor_vectors v1 v2 = [e1*e2 | e1<-v1, e2<-v2]

tensor_mat :: [[Double]] -> [[Double]] -> [[Double]]
tensor_mat [] [] = []
tensor_mat [] _ = []
tensor_mat _ [] = []
tensor_mat (v1:t1) m2 = tensor_matAux v1 m2 ++ tensor_mat t1 m2

tensor_matAux :: [Double] -> [[Double]] -> [[Double]]
tensor_matAux [] _ = []
tensor_matAux _ [] = []
tensor_matAux v1 (v2:t2) = tensor_vectors v1 v2 : tensor_matAux v1 t2

